RewriteEngine On

# never rewrite the WebRTC endpoint - the 301 eats POST bodies
RewriteCond %{REQUEST_URI} ^/log_rtc\.php$
RewriteRule ^ - [L]

# strip .php from incoming requests -> canonical extensionless URL
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# map extensionless URL to the real .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]
